#!/bin/bash

######################################################################
###  Estat
######################################################################
fnc_enrutar_estat() {

	source $DIR_WAN/wan.conf
	if sysctl -n net.ipv4.ip_forward | grep -q '^1$' && \
	   iptables -t nat -C POSTROUTING -o $WAN_INT  -j MASQUERADE 2>/dev/null; then
	    echo "$ACTIVAT"
	else
	    echo "$DESACTIVAT"
	fi
}
